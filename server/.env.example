PORT=5000
NODE_ENV=development

# MongoDB URI (If left blank or unavailable, the server automatically starts an in-memory MongoDB instance for local dev)
MONGODB_URI=mongodb://127.0.0.1:27017/college-memories

# JWT Authentication
JWT_SECRET=super_secret_college_memories_jwt_key_2026_scrapbook
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
